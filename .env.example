# Any OpenAI-compatible endpoint (NVIDIA Cloud, Moonshot, …)
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
HOTPATH_AGENT_MODEL=moonshotai/kimi-k3
HOTPATH_CHEAP_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional: none (the default) | low | medium | high | default. Sent as
# reasoning_effort to the cheap model (the workflow's llm steps) only. Thinking
# is off unless you ask for it: replay steps rewrite known data and thinking
# made them 2-20x slower. "default" sends nothing (the provider decides). A
# provider that rejects it gets the request again without it, once per model.
# HOTPATH_CHEAP_REASONING=low
# Optional: 0 turns off answer reuse. An llm step whose data is exactly what an
# earlier run had reuses that answer (kept in .hotpath/answers/), no model call.
# HOTPATH_REUSE=1
# Optional: token cap for one llm-step call, thinking included (default 16000,
# 0 = no cap). A model that thinks in a loop then drifts to the agent instead of
# running for minutes.
# HOTPATH_CHEAP_MAX_TOKENS=16000
# USD per 1M tokens (verify current prices on the platform)
PRICE_AGENT_IN=3
PRICE_AGENT_OUT=15
PRICE_CHEAP_IN=0.95
PRICE_CHEAP_OUT=4

# Example: local open models with Ollama (no account, no cost). Ollama ignores
# the key but the client needs one, so any text works. `ollama pull qwen3:1.7b`
# first. Record with a model that copies values word for word (qwen3 did,
# qwen2.5-coder paraphrased); replay with thinking off and mention repair on.
# See docs/BENCHMARK.md, "Local open models". Set every PRICE_* to 0.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# HOTPATH_AGENT_MODEL=qwen3:1.7b
# HOTPATH_CHEAP_MODEL=qwen3:1.7b
# HOTPATH_REPAIR_MENTIONS=1

# Example: Groq (any OpenAI-compatible provider works the same way)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# HOTPATH_AGENT_MODEL=openai/gpt-oss-120b
# HOTPATH_CHEAP_MODEL=openai/gpt-oss-20b
