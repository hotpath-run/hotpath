{
  "name": "hotpath",
  "version": "0.2.0",
  "description": "Record your AI agent once. Replay it faster and cheaper, with AI only where judgment is needed.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotpath-run/hotpath.git"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "llm",
    "workflow",
    "jit",
    "openclaw"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "eslint . && prettier --check .",
    "hotpath": "tsx packages/cli/src/index.ts",
    "bench": "pnpm --filter demo-tools build && tsx bench/src/index.ts",
    "bench:price": "tsx bench/src/price.ts",
    "bench:guard-audit": "tsx bench/src/guard-audit.ts",
    "bench:measure": "pnpm --filter demo-tools build && tsx bench/src/measure.ts",
    "bench:branching": "pnpm --filter demo-tools build && tsx bench/src/branching.ts",
    "bench:replay": "pnpm --filter demo-tools build && tsx bench/src/replay-tokens.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
