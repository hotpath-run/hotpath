{
  "name": "@hotpathrun/viewer",
  "version": "0.3.0",
  "description": "Vite + React Flow viewer for compiled Hotpath workflows",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotpath-run/hotpath.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://hotpath.run",
  "bugs": {
    "url": "https://github.com/hotpath-run/hotpath/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "llm",
    "workflow",
    "jit",
    "openclaw"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.build.json && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "@hotpathrun/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "@hotpathrun/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vitest": "^2.1.8"
  }
}
