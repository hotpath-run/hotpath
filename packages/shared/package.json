{
  "name": "@hotpathrun/shared",
  "version": "0.2.0",
  "description": "Shared schemas, template engine, pricing and LLM client for Hotpath",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotpath-run/hotpath.git",
    "directory": "packages/shared"
  },
  "homepage": "https://hotpath.run",
  "bugs": {
    "url": "https://github.com/hotpath-run/hotpath/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "llm",
    "workflow",
    "jit",
    "openclaw"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.build.json && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^2.1.8"
  }
}
