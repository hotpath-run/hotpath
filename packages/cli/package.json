    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/build-cli.mjs"
  },
  "devDependencies": {
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "@hotpathrun/compiler": "workspace:*",
    "@hotpathrun/learn": "workspace:*",
    "@hotpathrun/proxy": "workspace:*",
    "@hotpathrun/recorder": "workspace:*",
    "@hotpathrun/runtime": "workspace:*",
    "@hotpathrun/scheduler": "workspace:*",
    "@hotpathrun/shared": "workspace:*",
    "@hotpathrun/viewer": "workspace:*",
    "json5": "^2.2.3",
    "@types/cross-spawn": "^6.0.6",
    "demo-agent": "workspace:*",
    "demo-tools": "workspace:*"
  }
