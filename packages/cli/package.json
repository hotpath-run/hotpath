{
  "name": "@hotpathrun/cli",
  "version": "0.4.1",
  "description": "The hotpath command line: record, compile, show, run and view",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotpath-run/hotpath.git",
    "directory": "packages/cli"
  },
  "homepage": "https://hotpath.run",
  "bugs": {
    "url": "https://github.com/hotpath-run/hotpath/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "llm",
    "workflow",
    "jit",
    "openclaw"
  ],
  "type": "module",
  "bin": {
    "hotpath": "dist/hotpath.mjs"
  },
  "files": [
